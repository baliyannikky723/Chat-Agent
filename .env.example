# ─────────────────────────────────────────────────────────────────────────────
#  Orrery configuration. Copy this file to .env (npm run dev does it for you)
#  and fill in two keys: one model key and one search key.
#  Real environment variables override this file.
# ─────────────────────────────────────────────────────────────────────────────

# ── 1. Model: set ONE of these. Free, no card: Groq or Google Gemini. ──────────
# Groq (free tier):            https://console.groq.com/keys
GROQ_API_KEY=
# Google Gemini (free tier):   https://aistudio.google.com/apikey   (GOOGLE_API_KEY also works)
GEMINI_API_KEY=
# OpenAI:                      https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Anthropic:                   https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# OpenRouter (many models):    https://openrouter.ai/keys
OPENROUTER_API_KEY=

# With several keys set, the first in this order is used:
# OpenAI, Anthropic, Gemini, Groq, OpenRouter. Or choose one:
# LLM_PROVIDER=auto            # auto | openai | anthropic | google | groq | openrouter | openai-compatible

# Optional model overrides. Defaults are current models per provider, with fallbacks
# if a model is retired. The fast model writes titles and files facts in the background.
# LLM_MODEL=
# LLM_FAST_MODEL=
# LLM_REASONING_EFFORT=low     # low | medium | high (only for models that support it)

# Any OpenAI-compatible server (Ollama, LM Studio, vLLM...):
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1
# LLM_API_KEY=

# ── 2. Web search: set at least one. With several, the next takes over on errors. ──
# Tavily (1,000 free searches a month, no card): https://app.tavily.com/home
TAVILY_API_KEY=
# Brave Search API:            https://api-dashboard.search.brave.com/app/keys
BRAVE_API_KEY=
# Serper (Google results):     https://serper.dev/api-key
SERPER_API_KEY=
# SEARCH_PROVIDER=auto         # auto | tavily | brave | serper
# SEARCH_MAX_RESULTS=6         # results kept per search (3 to 10)
# SEARCH_MAX_PER_TURN=8        # searches allowed in one answer (2 to 16)

# ── 3. Demo tools ──────────────────────────────────────────────────────────────
# A demo clock and one-click sample history (3 November, Monday, last Tuesday), so the
# memory questions can be tried straight away. Set to false for real use.
DEMO_TOOLS=true

# ── 4. Server ──────────────────────────────────────────────────────────────────
# BACKEND_PORT=8080            # npm run dev picks the next free port if this one is taken
# BACKEND_HOST=127.0.0.1       # 0.0.0.0 to accept connections from other machines
# ORRERY_DATA_DIR=./data       # where the SQLite memory file lives
# ORRERY_BACKEND_URL=          # npm run dev only: use a backend you started yourself (IDE)
